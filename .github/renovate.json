{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    ":pinDevDependencies",
    "abandonments:recommended",
    "security:minimumReleaseAgeNpm",
    ":maintainLockFilesWeekly"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "commitMessagePrefix": "chore(deps): ",
  "nix": {
    "enabled": true
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/gitops/.*\\.yaml$/"
    ]
  },
  "helmv3": {
    "enabled": true
  },
  "flux": {
    "managerFilePatterns": [
      "/^gitops/espresso/.+\\.ya?ml$/"
    ]
  },
  "terraform": {
    "managerFilePatterns": [
      "/^gitops/espresso/tofu/.+\\.tf$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^gitops/espresso/infrastructure/controllers/gateway-api/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>kubernetes-sigs/gateway-api)/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)/config/crd/(?:standard|experimental)/gateway\\.networking\\.k8s\\.io_[^\\s]+\\.yaml"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^gitops/espresso/infrastructure/controllers/postgres/Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*suite=(?<suite>\\S+)\\s+depName=(?<depName>\\S+)\\s+ARG\\s+\\S+_VERSION=(?<currentValue>\\S+)"
      ],
      "registryUrlTemplate": "https://apt.postgresql.org/pub/repos/apt?suite={{suite}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "groupName": "all patch dependencies"
    },
    {
      "matchUpdateTypes": ["minor"],
      "groupName": "all minor dependencies"
    },
    {
      "matchManagers": [
        "nix"
      ],
      "groupName": "nix flake updates"
    },
    {
      "enabled": false,
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_version"
      ],
      "matchPackageNames": [
        "hashicorp/terraform"
      ]
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "/nix-secrets/"
      ]
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "registry.k8s.io/pause"
      ]
    }
  ]
}
