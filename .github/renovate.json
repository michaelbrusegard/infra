{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":separateMultipleMajorReleases",
    "abandonments:recommended",
    "security:minimumReleaseAgeNpm",
    ":maintainLockFilesWeekly"
  ],
  "timezone": "Europe/Oslo",
  "schedule": [
    "before 09:00 on monday"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "labels": [
    "dependencies"
  ],
  "commitMessagePrefix": "chore(deps): ",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "nix": {
    "enabled": true
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/gitops/.*\\.yaml$/"
    ]
  },
  "helmv3": {
    "enabled": true
  },
  "flux": {
    "managerFilePatterns": [
      "/^gitops/espresso/.+\\.ya?ml$/"
    ]
  },
  "terraform": {
    "managerFilePatterns": [
      "/^gitops/espresso/tofu/.+\\.tf$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^gitops/espresso/infrastructure/controllers/gateway-api/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>kubernetes-sigs/gateway-api)/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)/config/crd/(?:standard|experimental)/gateway\\.networking\\.k8s\\.io_[^\\s]+\\.yaml"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^gitops/espresso/infrastructure/controllers/postgres/Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*suite=(?<suite>\\S+)\\s+depName=(?<depName>\\S+)\\s+ARG\\s+\\S+_VERSION=(?<currentValue>\\S+)"
      ],
      "registryUrlTemplate": "https://apt.postgresql.org/pub/repos/apt?suite={{suite}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "groupName": "container & action digests",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "all patch dependencies",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "all minor dependencies"
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "groupName": "lock file maintenance",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchManagers": [
        "nix"
      ],
      "groupName": "nix flake updates"
    },
    {
      "matchManagers": [
        "helmv3",
        "flux"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "automerge": false
    },
    {
      "enabled": false,
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_version"
      ],
      "matchPackageNames": [
        "hashicorp/terraform"
      ]
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "/nix-secrets/"
      ]
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "registry.k8s.io/pause"
      ]
    }
  ]
}
