+def _resolve_delegation_profile(
+    cfg: dict, requested_profile: Optional[str]
+) -> tuple[dict, Optional[str]]:
+    """Merge a configured capability profile onto delegation defaults.
+
+    Profiles select provider/model capability, while ``role`` continues to
+    control delegation topology. Configurations without profiles preserve the
+    historical single-route behavior.
+    """
+    profiles = cfg.get("profiles")
+    if not isinstance(profiles, dict) or not profiles:
+        if requested_profile:
+            raise ValueError(
+                f"Unknown delegation profile '{requested_profile}': "
+                "delegation.profiles is not configured."
+            )
+        return dict(cfg), None
+
+    requested = str(requested_profile or "").strip()
+    default_profile = str(cfg.get("default_profile") or "").strip()
+    selected = requested or default_profile
+    available = sorted(str(name) for name in profiles)
+    if not selected:
+        raise ValueError(
+            "delegation.profiles is configured but delegation.default_profile "
+            f"is missing. Available profiles: {', '.join(available)}"
+        )
+
+    profile_cfg = profiles.get(selected)
+    if not isinstance(profile_cfg, dict):
+        raise ValueError(
+            f"Unknown delegation profile '{selected}'. Available profiles: "
+            f"{', '.join(available)}"
+        )
+
+    merged = {
+        key: value
+        for key, value in cfg.items()
+        if key not in {"profiles", "default_profile"}
+    }
+    merged.update(profile_cfg)
+    return merged, selected
+
+
