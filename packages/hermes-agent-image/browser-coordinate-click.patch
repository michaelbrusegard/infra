+def browser_click_at(x: int, y: int, task_id: Optional[str] = None) -> str:
+    """Click page viewport coordinates for visual-only targets."""
+    if _is_camofox_mode():
+        return json.dumps({
+            "success": False,
+            "error": "Coordinate clicking is unavailable with the Camofox backend. Use a snapshot ref instead.",
+        }, ensure_ascii=False)
+
+    try:
+        click_x = int(x)
+        click_y = int(y)
+    except (TypeError, ValueError):
+        return json.dumps({
+            "success": False,
+            "error": "x and y must be integer viewport coordinates",
+        }, ensure_ascii=False)
+
+    if not (0 <= click_x <= 10000 and 0 <= click_y <= 10000):
+        return json.dumps({
+            "success": False,
+            "error": "x and y must be between 0 and 10000 CSS pixels",
+        }, ensure_ascii=False)
+
+    effective_task_id = _last_session_key(task_id or "default")
+    blocked = _blocked_private_page_action(effective_task_id, "click")
+    if blocked is not None:
+        return blocked
+
+    actions = (
+        ("move", [str(click_x), str(click_y)]),
+        ("down", []),
+        ("up", []),
+    )
+    result: Dict[str, Any] = {}
+    for action, action_args in actions:
+        result = _run_browser_command(
+            effective_task_id, "mouse", [action, *action_args])
+        if not result.get("success"):
+            if action == "down":
+                _run_browser_command(effective_task_id, "mouse", ["up"])
+            response = {
+                "success": False,
+                "error": result.get(
+                    "error", f"Failed mouse {action} at ({click_x}, {click_y})"),
+            }
+            return json.dumps(
+                _copy_fallback_warning(response, result), ensure_ascii=False)
+
+    response = {
+        "success": True,
+        "clicked": {"x": click_x, "y": click_y},
+    }
+    return json.dumps(
+        _copy_fallback_warning(response, result), ensure_ascii=False)
+
+
