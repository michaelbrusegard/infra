+        return json.dumps({
+            "success": False,
+            "error": "Managed downloads are unavailable with the Camofox backend.",
+        }, ensure_ascii=False)
+
+    effective_task_id = _last_session_key(task_id or "default")
+    if not ref.startswith("@"):
+        ref = f"@{ref}"
+    try:
+        from tools.browser_session_router import download_path
+        destination = download_path(effective_task_id, filename)
+    except (OSError, ValueError) as exc:
+        return json.dumps({"success": False, "error": str(exc)}, ensure_ascii=False)
+
+    result = _run_browser_command(
