+def browser_upload(ref: str, paths: List[str], task_id: Optional[str] = None) -> str:
+    """Stage files on shared storage and populate a browser file input."""
+    if _is_camofox_mode():
+        return json.dumps({
+            "success": False,
+            "error": "File uploads are unavailable with the Camofox backend.",
+        }, ensure_ascii=False)
+
+    effective_task_id = _last_session_key(task_id or "default")
+    blocked = _blocked_private_page_action(effective_task_id, "upload")
+    if blocked is not None:
+        return blocked
+    if not isinstance(paths, list) or not all(isinstance(path, str) for path in paths):
+        return json.dumps({
+            "success": False,
+            "error": "paths must be a list of absolute file paths",
+        }, ensure_ascii=False)
+
+    try:
+        from tools.browser_session_router import stage_uploads
+        staged = stage_uploads(effective_task_id, paths)
+    except (OSError, ValueError) as exc:
+        return json.dumps({"success": False, "error": str(exc)}, ensure_ascii=False)
+
+    result = _run_browser_command(effective_task_id, "upload", [ref, *staged])
+    if not result.get("success"):
+        return json.dumps(result, ensure_ascii=False)
+    return json.dumps({
+        "success": True,
+        "uploaded": staged,
+        "count": len(staged),
+    }, ensure_ascii=False)
+
+
+def browser_download(
+    ref: str, filename: str, task_id: Optional[str] = None,
+) -> str:
+    """Download a file to storage mounted at the same path in Chrome."""
+    if _is_camofox_mode():
+        return json.dumps({
+            "success": False,
+            "error": "Managed downloads are unavailable with the Camofox backend.",
+        }, ensure_ascii=False)
+
+    effective_task_id = _last_session_key(task_id or "default")
+    blocked = _blocked_private_page_action(effective_task_id, "download")
+    if blocked is not None:
+        return blocked
+    try:
+        from tools.browser_session_router import download_path
+        destination = download_path(effective_task_id, filename)
+    except (OSError, ValueError) as exc:
+        return json.dumps({"success": False, "error": str(exc)}, ensure_ascii=False)
+
+    result = _run_browser_command(
+        effective_task_id, "download", [ref, destination], timeout=120)
+    if not result.get("success"):
+        return json.dumps(result, ensure_ascii=False)
+    downloaded = Path(destination)
+    if not downloaded.is_file():
+        return json.dumps({
+            "success": False,
+            "error": "The browser reported success but the downloaded file is missing",
+            "path": destination,
+        }, ensure_ascii=False)
+    return json.dumps({
+        "success": True,
+        "path": destination,
+        "filename": downloaded.name,
+        "size_bytes": downloaded.stat().st_size,
+    }, ensure_ascii=False)
+
+
