@@ -526,0 +527,16 @@ def _resolve_progress_thread_id(platform: Any, source_thread_id: Any, event_messa
+def _normalize_gateway_tool_progress_event(
+    event_type: str,
+) -> tuple[Optional[str], bool]:
+    """Map delegated child tools onto normal gateway progress rendering.
+
+    Per-tool child events should look like the parent's own tool calls. The
+    delegation layer also emits periodic tool-name summaries; suppress those
+    here so messaging platforms do not show the same work twice.
+    """
+    if event_type == "subagent.tool":
+        return "tool.started", True
+    if event_type in {"subagent.progress", "subagent_progress"}:
+        return None, False
+    return event_type, False
+
+
@@ -19168,2 +19168,6 @@ class GatewayRunner(GatewayAuthorizationMixin, GatewayKanbanWatchersMixin, Gatew
         def progress_callback(event_type: str, tool_name: str = None, preview: str = None, args: dict = None, **kwargs):
             """Callback invoked by agent on tool lifecycle events."""
+            event_type, delegated_tool = _normalize_gateway_tool_progress_event(event_type)
+            if event_type is None:
+                return
+            progress_prefix = "🔀 " if delegated_tool else ""
@@ -19318 +19322,3 @@ class GatewayRunner(GatewayAuthorizationMixin, GatewayKanbanWatchersMixin, Gatew
