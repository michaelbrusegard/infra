Subject: [PATCH] fix(provider): report reload errors after saving state

Reload failures leave settings persisted but inactive. Fail the operation
with the server error, retaining read-back state (or the completed deletion)
before reload so an error or timeout cannot hide the successful write.
Allow action requests 120 seconds for OIDC discovery and bundle downloads,
without extending ordinary API requests or overriding cancellation.

diff --git a/internal/client/client.go b/internal/client/client.go
--- a/internal/client/client.go
+++ b/internal/client/client.go
@@ -187 +187,12 @@
-	resp, err := c.http.Do(req)
+	// Actions can validate OIDC discovery and download application bundles.
+	// Keep ordinary requests bounded without cutting off the server's result.
+	httpClient := c.http
+	for _, call := range calls {
+		if call.Name == "x:Action/set" {
+			actionClient := *c.http
+			actionClient.Timeout = max(actionClient.Timeout, 120*time.Second)
+			httpClient = &actionClient
+			break
+		}
+	}
+	resp, err := httpClient.Do(req)
diff --git a/internal/client/client_test.go b/internal/client/client_test.go
--- a/internal/client/client_test.go
+++ b/internal/client/client_test.go
@@ -178,0 +179,29 @@
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestActionTimeout(t *testing.T) {
+	for _, timeout := range []time.Duration{30 * time.Second, 180 * time.Second} {
+		var actions atomic.Int64
+		c := newTestClient(t, testServer(t, &actions), true)
+		c.http.Timeout = timeout
+		c.http.Transport = roundTripFunc(func(r *http.Request) (*http.Response, error) {
+			deadline, ok := r.Context().Deadline()
+			want := max(timeout, 120*time.Second)
+			if !ok || time.Until(deadline) < want-time.Second || time.Until(deadline) > want {
+				t.Errorf("action deadline = %v, want %s remaining", deadline, want)
+			}
+			return nil, errors.New("test transport failure")
+		})
+		if err := c.Reload(context.Background(), "ReloadSettings"); err == nil {
+			t.Fatal("transport error lost")
+		}
+		if c.http.Timeout != timeout {
+			t.Errorf("ordinary request timeout changed to %s", c.http.Timeout)
+		}
+		if _, ok := c.lastReload["ReloadSettings"]; ok {
+			t.Fatal("failed reload marked successful")
+		}
+	}
+}
