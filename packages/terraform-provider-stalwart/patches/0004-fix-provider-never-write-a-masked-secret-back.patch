Subject: [PATCH] fix(provider): never write a masked secret back

Stalwart v1 returns secrets as "****" and stores a written "****"
literally, except in account credentials. A secret imported without a
configured value is the mask in state, so the next update replaced the
real secret with the mask. Leave such a property unchanged instead.
---
 internal/provider/convert.go          | 15 +++++++
 internal/provider/convert_test.go     | 58 +++++++++++++++++++++++++++
 internal/provider/generic_resource.go |  6 +++
 3 files changed, 79 insertions(+)

diff --git a/internal/provider/convert.go b/internal/provider/convert.go
index 99788bc..42967ab 100644
--- a/internal/provider/convert.go
+++ b/internal/provider/convert.go
@@ -252,6 +252,21 @@ func toJMAP(ctx context.Context, v attr.Value) (any, error) {
 
 const maskedSecret = "****"
 
+func containsMasked(v any) bool {
+	switch typed := v.(type) {
+	case string:
+		return typed == maskedSecret
+	case map[string]any:
+		for _, item := range typed {
+			if containsMasked(item) {
+				return true
+			}
+		}
+	}
+
+	return false
+}
+
 func fillUnknowns(plan, fresh attr.Value) attr.Value {
 	if plan == nil || plan.IsUnknown() {
 		return fresh
diff --git a/internal/provider/convert_test.go b/internal/provider/convert_test.go
index 7b932c1..7036e0b 100644
--- a/internal/provider/convert_test.go
+++ b/internal/provider/convert_test.go
@@ -431,3 +431,61 @@ func TestNestedServerSetAttributesAreNotSent(t *testing.T) {
 		t.Fatalf("writable credential fields lost: %v", first)
 	}
 }
+
+func TestPayloadKeepsMaskedSecretsOnServer(t *testing.T) {
+	t.Parallel()
+
+	secret := rschema.SingleNestedAttribute{Optional: true, Computed: true, Attributes: map[string]rschema.Attribute{
+		"type":   rschema.StringAttribute{Required: true},
+		"secret": rschema.StringAttribute{Optional: true, Computed: true, Sensitive: true},
+	}}
+	secretType := types.ObjectType{AttrTypes: map[string]attr.Type{
+		"type":   types.StringType,
+		"secret": types.StringType,
+	}}
+	attrTypes := map[string]attr.Type{
+		"id":          types.StringType,
+		"name":        types.StringType,
+		"auth_secret": secretType,
+	}
+
+	masked, diags := types.ObjectValue(secretType.AttrTypes, map[string]attr.Value{
+		"type":   types.StringValue("Value"),
+		"secret": types.StringValue(maskedSecret),
+	})
+	if diags.HasError() {
+		t.Fatalf("unexpected diagnostics: %v", diags)
+	}
+	plan, diags := types.ObjectValue(attrTypes, map[string]attr.Value{
+		"id":          types.StringValue("b"),
+		"name":        types.StringValue("mx"),
+		"auth_secret": masked,
+	})
+	if diags.HasError() {
+		t.Fatalf("unexpected diagnostics: %v", diags)
+	}
+
+	for jmapType, wantSent := range map[string]bool{"x:MtaRoute": false, "x:Account": true} {
+		r := &genericResource{descriptor: resourceDescriptor{
+			Name:     "masked",
+			JMAPType: jmapType,
+			Schema: rschema.Schema{Attributes: map[string]rschema.Attribute{
+				"id":          rschema.StringAttribute{Computed: true},
+				"name":        rschema.StringAttribute{Required: true},
+				"auth_secret": secret,
+			}},
+		}}
+
+		payload, err := r.payload(context.Background(), plan, plan, true)
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+
+		if _, sent := payload["authSecret"]; sent != wantSent {
+			t.Errorf("%s: authSecret sent = %v, want %v: %v", jmapType, sent, wantSent, payload)
+		}
+		if payload["name"] != "mx" {
+			t.Errorf("%s: unmasked attributes lost: %v", jmapType, payload)
+		}
+	}
+}
diff --git a/internal/provider/generic_resource.go b/internal/provider/generic_resource.go
index 07c5518..25a49d6 100644
--- a/internal/provider/generic_resource.go
+++ b/internal/provider/generic_resource.go
@@ -276,6 +276,12 @@ func (r *genericResource) payload(ctx context.Context, plan, config types.Object
 		if err != nil {
 			return nil, fmt.Errorf("attribute %q: %w", name, err)
 		}
+		// A mask in the plan means the secret is unknown, typically after an
+		// import. Stalwart stores a written mask literally, except in account
+		// credentials, so leave such a property unchanged on the server.
+		if r.descriptor.JMAPType != "x:Account" && containsMasked(converted) {
+			continue
+		}
 		out[rootFieldName(name)] = converted
 	}
 
