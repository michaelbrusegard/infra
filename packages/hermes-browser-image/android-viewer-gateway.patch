+async def handle_screenshot(request):
+    """GET /api/v1/emulator/screenshot returns the secure-capable framebuffer."""
+    if not EMULATOR_CHANNEL:
+        return web.json_response({"error": "No channel to emulator"}, status=503)
+
+    try:
+        stub = ec_grpc.EmulatorControllerStub(EMULATOR_CHANNEL)
+        metadata = get_emulator_metadata()
+        image = await stub.getScreenshot(
+            ec.ImageFormat(format=ec.ImageFormat.PNG, display=0),
+            metadata=metadata,
+        )
+        if not image.image:
+            return web.json_response({"error": "Emulator returned no image"}, status=503)
+        return web.Response(
+            body=image.image,
+            content_type="image/png",
+            headers={"Cache-Control": "no-store, max-age=0"},
+        )
+    except Exception as e:
+        logging.error(f"Error fetching emulator screenshot: {e}")
+        return web.json_response({"error": str(e)}, status=500)
+
+
+async def handle_input(request):
+    """POST /api/v1/emulator/input injects fallback mouse or keyboard input."""
+    if not EMULATOR_CHANNEL:
+        return web.json_response({"error": "No channel to emulator"}, status=503)
+
+    try:
+        data = await request.json()
+        event_type = data.get("type")
+        stub = ec_grpc.EmulatorControllerStub(EMULATOR_CHANNEL)
+        metadata = get_emulator_metadata()
+        if event_type == "mouse":
+            await stub.sendMouse(
+                ec.MouseEvent(
+                    x=max(0, int(data.get("x", 0))),
+                    y=max(0, int(data.get("y", 0))),
+                    buttons=max(0, int(data.get("buttons", 0))),
+                    display=0,
+                ),
+                metadata=metadata,
+            )
+        elif event_type == "keyboard":
+            key = str(data.get("key", ""))
+            if not key:
+                return web.json_response({"error": "Keyboard key is required"}, status=400)
+            event_names = {
+                "keydown": ec.KeyboardEvent.keydown,
+                "keyup": ec.KeyboardEvent.keyup,
+                "keypress": ec.KeyboardEvent.keypress,
+            }
+            requested_event = str(data.get("event", "keypress"))
+            if requested_event not in event_names:
+                return web.json_response({"error": "Unknown keyboard event"}, status=400)
+            await stub.sendKey(
+                ec.KeyboardEvent(eventType=event_names[requested_event], key=key),
+                metadata=metadata,
+            )
+        else:
+            return web.json_response({"error": "Unknown input type"}, status=400)
+        return web.json_response({"status": "success"})
+    except Exception as e:
+        logging.error(f"Error injecting emulator input: {e}")
+        return web.json_response({"error": str(e)}, status=500)
+
+
