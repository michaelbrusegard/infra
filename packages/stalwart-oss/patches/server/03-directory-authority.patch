+            // Nested JIT group synchronizations have finished by this point.
+            // Capture once, read policy fresh, and carry this exact epoch into
+            // the commit. A conflict fails closed; never refresh a stale draft.
+            let epoch = self.registry().independent_scim_epoch().await?;
+            let (object, old_object) = match &write {
+                RegistryWrite::Insert { object, .. } => (*object, None),
+                RegistryWrite::Update { object, old_object, .. } => (*object, Some(*old_object)),
+                _ => return Err(trc::AuthEvent::Error.into_err()
+                    .details("Unsupported directory mutation")),
+            };
+            let registry::schema::prelude::ObjectInner::Account(new) = &object.inner else {
+                return Err(trc::AuthEvent::Error.into_err().details("Expected directory account"));
+            };
+            let old = old_object.and_then(|object| match &object.inner {
+                registry::schema::prelude::ObjectInner::Account(account) => Some(account),
+                _ => None,
+            });
+            let (domain_id, aliases) = match new {
+                Account::User(account) => (account.domain_id, &account.aliases),
+                Account::Group(account) => (account.domain_id, &account.aliases),
+            };
+            if self.scim_domain_authoritative(domain_id).await? {
+                return Err(trc::AuthEvent::Error.into_err()
+                    .details("Directory cannot modify a SCIM-authoritative identity"));
+            }
