+                    && self.scim_domain_authoritative(alias.domain_id).await?
+                {
+                    return Err(trc::AuthEvent::Error.into_err()
+                        .details("Directory cannot change SCIM-authoritative aliases"));
+                }
+            }
+            if let Some(old_aliases) = old_aliases {
+                for alias in old_aliases.iter() {
