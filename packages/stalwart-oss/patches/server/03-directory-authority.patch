+    #[cfg(feature = "independent-scim")]
+    async fn scim_domain_authoritative(&self, domain_id: Id) -> trc::Result<bool> {
+        // Never trust a cached policy after capturing the epoch: a domain write
+        // can commit before its asynchronous cache invalidation is delivered.
+        self.registry().object::<registry::schema::structs::Domain>(domain_id).await?
+            .map(|domain| domain.allow_scim_provisioning)
+            .ok_or_else(|| trc::AuthEvent::Error.into_err()
+                .details("Directory domain no longer exists"))
+    }
