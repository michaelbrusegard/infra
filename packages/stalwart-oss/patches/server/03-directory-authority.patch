+    #[cfg(feature = "independent-scim")]
+    async fn scim_directory_identity(
+        &self, local: &str, domain: &DomainCache,
+    ) -> trc::Result<AccountWithId> {
+        let id = self.account_id_from_parts(local, domain.id).await?
