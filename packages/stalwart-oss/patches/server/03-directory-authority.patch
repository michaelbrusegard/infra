+                    Some(Account::User(old)) => old.member_group_ids.as_slice(),
+                    _ => &[],
+                };
+                for id in new.member_group_ids.iter() {
+                    if !old_members.contains(id) && self.scim_group_authoritative(*id).await? {
+                        return Err(trc::AuthEvent::Error.into_err()
+                            .details("Directory cannot add SCIM-authoritative group membership"));
