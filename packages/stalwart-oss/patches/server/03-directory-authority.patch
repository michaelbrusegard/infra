+    #[cfg(feature = "independent-scim")]
+    async fn scim_group_authoritative(&self, group_id: Id) -> trc::Result<bool> {
+        match self.registry().object::<Account>(group_id).await? {
+            Some(Account::Group(group)) => self.scim_domain_authoritative(group.domain_id).await,
+            _ => Err(trc::AuthEvent::Error.into_err()
+                .details("Directory membership target is not an existing group")),
+        }
+    }
+
+    #[cfg(feature = "independent-scim")]
+    async fn scim_directory_memberships(
+        &self, current: &[Id], requested: Vec<Id>,
+    ) -> trc::Result<Vec<Id>> {
+        let mut members = Vec::with_capacity(requested.len().max(current.len()));
+        for id in requested {
+            // An external directory does not own protected group membership:
+            // ignore new claims, but keep ordinary profile synchronization.
+            if (current.contains(&id) || !self.scim_group_authoritative(id).await?)
+                && !members.contains(&id)
+            {
+                members.push(id);
+            }
+        }
+        for id in current {
+            if !members.contains(id) && self.scim_group_authoritative(*id).await? {
+                members.push(*id);
+            }
+        }
+        Ok(members)
+    }
