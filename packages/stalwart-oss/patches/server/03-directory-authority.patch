+                        return Err(trc::AuthEvent::Error
+                            .into_err()
+                            .details("Directory cannot remove SCIM-authoritative group membership"));
+                    }
+                }
+            }
+            self.registry().write_with_independent_scim_epoch(write, epoch).await
+        }
+    }
