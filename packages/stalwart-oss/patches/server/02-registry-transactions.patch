+#[cfg(feature = "independent-scim")]
+pub fn independent_scim_key(key: &[u8]) -> ValueClass {
+    // The system subspace lives in the data store with the registry, so these
+    // keys commit in the same batch. Its own keys are single SystemKind bytes.
+    ValueClass::Any(crate::write::AnyClass {
+        subspace: crate::Subspace::System,
+        key: key.to_vec(),
+    })
+}
