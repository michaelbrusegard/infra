+    pub async fn independent_scim_epoch(&self) -> trc::Result<Option<u64>> {
+        let key = ValueClass::InMemory(crate::write::InMemoryClass::Key(
+            INDEPENDENT_SCIM_EPOCH_KEY.to_vec(),
+        ));
+        self.store().get_value::<IndependentScimEpoch>(ValueKey::from(key)).await
+            .map(|epoch| epoch.map(|epoch| epoch.0))
