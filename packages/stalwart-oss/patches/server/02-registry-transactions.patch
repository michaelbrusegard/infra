+    #[cfg(feature = "independent-scim")]
+    async fn assert_independent_scim_epoch(
+        &self, batch: &mut BatchBuilder, expected: Option<Option<u64>>,
+    ) -> trc::Result<()> {
+        // Some(None) means the caller observed an absent marker. Never refresh
+        // a supplied guard: the caller's policy reads precede this write.
+        let epoch = match expected {
+            Some(epoch) => epoch,
+            None => self.independent_scim_epoch().await?,
+        };
+        batch.assert_value(
+            ValueClass::InMemory(crate::write::InMemoryClass::Key(
+                INDEPENDENT_SCIM_EPOCH_KEY.to_vec(),
+            )),
+            epoch.map_or(AssertValue::None, AssertValue::U64),
+        );
+        Ok(())
+    }
