+#[cfg(feature = "independent-scim")]
+async fn independent_scim_acl_cleanup<R, E>(
+    cleanup: impl std::future::Future<Output = Result<R, E>>,
+    invalidation: impl std::future::Future<Output = Result<(), E>>,
+) -> Result<(), E> {
+    let cleanup_result = cleanup.await;
+    // Also run after partial cleanup failure. If enumeration or eviction fails,
+    // return an error so the durable destruction task retries the entire sweep.
+    invalidation.await?;
+    cleanup_result.map(|_| ())
+}
