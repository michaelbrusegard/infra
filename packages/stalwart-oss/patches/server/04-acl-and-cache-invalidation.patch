+#[cfg(all(test, feature = "independent-scim"))]
+mod independent_scim_acl_retry_tests {
+    use super::independent_scim_acl_cleanup;
+    use std::{cell::{Cell, RefCell}, collections::BTreeSet, future::Future, task::{Context, Poll, Waker}};
+
+    fn ready<T>(future: impl Future<Output = T>) -> T {
+        match Box::pin(future).as_mut().poll(&mut Context::from_waker(Waker::noop())) {
+            Poll::Ready(result) => result,
+            Poll::Pending => panic!("test future unexpectedly blocked"),
+        }
+    }
+
+    // These exercise the production async ordering helper with faulting futures,
+    // not a native Store or cache backend. The live fixture still owns that proof.
+    #[test]
+    fn partial_cleanup_failure_still_invalidates_and_retry_sweeps_all() {
+        let acl = RefCell::new(BTreeSet::from([1u32, 2]));
+        let live_accounts = [1u32, 2, 3];
+        let cached = RefCell::new(BTreeSet::from(live_accounts));
+        let sweeps = Cell::new(0);
+        let result = ready(independent_scim_acl_cleanup(
+            async {
+                acl.borrow_mut().remove(&1); // first committed chunk
+                Err::<usize, _>("cleanup chunk failed")
+            },
+            async {
+                assert_eq!(*acl.borrow(), BTreeSet::from([2]));
+                for id in live_accounts { cached.borrow_mut().remove(&id); }
+                sweeps.set(sweeps.get() + 1);
+                Ok::<(), &str>(())
+            },
+        ));
+        assert_eq!(result, Err("cleanup chunk failed"));
+        assert!(cached.borrow().is_empty());
+        // Prior recipient 1 is no longer discoverable from ACLs on retry.
+        cached.borrow_mut().extend(live_accounts);
+        let result = ready(independent_scim_acl_cleanup(
+            async {
+                assert!(!acl.borrow().contains(&1));
+                let remaining = acl.borrow().len();
+                acl.borrow_mut().clear();
+                Ok::<usize, &str>(remaining)
+            },
+            async {
+                for id in live_accounts { cached.borrow_mut().remove(&id); }
+                sweeps.set(sweeps.get() + 1);
+                Ok::<(), &str>(())
+            },
+        ));
+        assert_eq!(result, Ok(()));
+        assert_eq!(sweeps.get(), 2);
+        assert!(cached.borrow().is_empty());
+    }
+
+    #[test]
+    fn failed_invalidation_retries_even_when_all_acl_rows_are_gone() {
+        let acl = RefCell::new(BTreeSet::from([1u32]));
+        let cached = RefCell::new(BTreeSet::from([1u32, 2]));
+        let result = ready(independent_scim_acl_cleanup(
+            async { acl.borrow_mut().clear(); Ok::<usize, &str>(1) },
+            async { Err::<(), _>("enumeration or eviction failed") },
+        ));
+        assert_eq!(result, Err("enumeration or eviction failed"));
+        assert!(acl.borrow().is_empty());
+        assert!(!cached.borrow().is_empty());
+        let result = ready(independent_scim_acl_cleanup(
+            async { assert!(acl.borrow().is_empty()); Ok::<usize, &str>(0) },
+            async { cached.borrow_mut().clear(); Ok::<(), &str>(()) },
+        ));
+        assert_eq!(result, Ok(()));
+        assert!(cached.borrow().is_empty());
+    }
+
+    #[test]
+    fn cancelled_partial_cleanup_is_recovered_by_the_next_global_sweep() {
+        let acl = RefCell::new(BTreeSet::from([1u32, 2]));
+        let cached = RefCell::new(BTreeSet::from([1u32, 2]));
+        let sweeps = Cell::new(0);
+        let mut interrupted = Box::pin(independent_scim_acl_cleanup(
+            async {
+                acl.borrow_mut().remove(&1);
+                std::future::pending::<Result<usize, &str>>().await
+            },
+            async {
+                sweeps.set(sweeps.get() + 1);
+                cached.borrow_mut().clear();
+                Ok::<(), &str>(())
+            },
+        ));
+        assert!(interrupted.as_mut().poll(&mut Context::from_waker(Waker::noop())).is_pending());
+        drop(interrupted); // task cancellation before invalidation can execute
+        assert_eq!(sweeps.get(), 0);
+        assert_eq!(*acl.borrow(), BTreeSet::from([2]));
+        let result = ready(independent_scim_acl_cleanup(
+            async { acl.borrow_mut().clear(); Ok::<usize, &str>(1) },
+            async {
+                cached.borrow_mut().clear();
+                sweeps.set(sweeps.get() + 1);
+                Ok::<(), &str>(())
+            },
+        ));
+        assert_eq!(result, Ok(()));
+        assert_eq!(sweeps.get(), 1);
+        assert!(cached.borrow().is_empty());
+    }
+}
