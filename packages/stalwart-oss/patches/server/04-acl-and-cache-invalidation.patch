+/// Revoke owned grants and evict every account even after partial failure.
+/// Retries cannot rely on ACL rows that an earlier attempt already removed.
+#[cfg(feature = "independent-scim")]
+pub async fn independent_scim_revoke_account_grants(server: &Server, account_id: u32) -> trc::Result<()> {
+    use crate::task_manager::tasks::rebuild_shares::RevokeAccountGrants;
+    independent_scim_acl_cleanup(
+        server.revoke_account_grants(account_id),
+        async {
+            let accounts = server.registry().query::<Vec<Id>>(
+                RegistryQuery::new(ObjectType::Account),
+            ).await?;
+            let mut invalidation = CacheInvalidationBuilder::default();
+            invalidation.invalidate(CacheInvalidation::AccessToken(account_id));
+            for account in accounts {
+                invalidation.invalidate(CacheInvalidation::AccessToken(account.document_id()));
+            }
+            server.invalidate_caches(invalidation).await
+        },
+    ).await
+}
