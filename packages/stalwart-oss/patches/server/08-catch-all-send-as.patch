+/// Whether an account may send as an address no principal claims, because the
+/// address's domain has a catch-all that delivers to that account.
+///
+/// This only governs which identities exist. The lookups read cached data, so
+/// an address reassigned concurrently can still get an identity, and one left
+/// behind after ownership changes is kept. Neither grants sending: the SMTP
+/// must_match_sender rule still decides which addresses a submission may use.
+async fn is_catch_all_sender(
+    server: &Server,
+    account_id: u32,
+    address: &str,
+) -> trc::Result<bool> {
+    let Some(domain) = server.domain(address.domain_part()).await? else {
+        return Ok(false);
+    };
+    let Some(catch_all) = domain.catch_all.as_deref() else {
+        return Ok(false);
+    };
+    // An external directory may own recipients the registry does not know.
+    if server
+        .get_directory_for_cached_domain(&domain)
+        .is_some_and(|directory| directory.can_lookup_recipients())
+    {
+        return Ok(false);
+    }
+    Ok(catch_all_sender(
+        account_id,
+        server.rcpt_id_from_email(address).await?,
+        server.account_id_from_email(address, true).await?,
+        server.account_id_from_email(catch_all, false).await?,
+    ))
+}
+
+/// `exact` is whatever claims the address itself, including lists and
+/// disabled addresses; `resolved` is the account it delivers to after
+/// sub-addressing and catch-all fallback; `catch_all` is the account the
+/// domain's catch-all names. Checking `exact` first stops sub-addressing from
+/// stripping an exactly claimed `local+tag` down to an unclaimed `local`.
+fn catch_all_sender(
+    account_id: u32,
+    exact: Option<EmailCache>,
+    resolved: Option<u32>,
+    catch_all: Option<u32>,
+) -> bool {
+    exact.is_none() && resolved == Some(account_id) && catch_all == Some(account_id)
+}
