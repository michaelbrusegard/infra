+#[cfg(test)]
+mod tests {
+    use super::catch_all_sender;
+
+    const OWNER: u32 = 1;
+    const OTHER: u32 = 2;
+
+    #[test]
+    fn catch_all_sender_allows_unclaimed_address_on_own_catch_all() {
+        assert!(catch_all_sender(OWNER, Some(OWNER), Some(OWNER)));
+    }
+
+    #[test]
+    fn catch_all_sender_denies_catch_all_to_another_account() {
+        assert!(!catch_all_sender(OWNER, Some(OTHER), Some(OTHER)));
+    }
+
+    #[test]
+    fn catch_all_sender_denies_address_owned_by_another_principal() {
+        assert!(!catch_all_sender(OWNER, Some(OWNER), Some(OTHER)));
+        // Lists and disabled addresses resolve to no account.
+        assert!(!catch_all_sender(OWNER, Some(OWNER), None));
+    }
+
+    #[test]
+    fn catch_all_sender_denies_without_catch_all() {
+        assert!(!catch_all_sender(OWNER, None, None));
+    }
+}
