+#[cfg(test)]
+mod tests {
+    use super::catch_all_sender;
+    use common::auth::EmailCache;
+
+    const OWNER: u32 = 1;
+    const OTHER: u32 = 2;
+
+    #[test]
+    fn catch_all_sender_allows_unclaimed_address_on_own_catch_all() {
+        assert!(catch_all_sender(OWNER, None, Some(OWNER), Some(OWNER)));
+    }
+
+    #[test]
+    fn catch_all_sender_denies_exact_sub_address_owned_by_another_account() {
+        // vip+tag is another account's alias; sub-addressing strips it to an
+        // unclaimed vip, which falls back to the catch-all.
+        let exact = Some(EmailCache::Account(OTHER));
+        assert!(!catch_all_sender(OWNER, exact, Some(OWNER), Some(OWNER)));
+    }
+
+    #[test]
+    fn catch_all_sender_denies_claimed_address() {
+        for exact in [
+            EmailCache::MailingList(OTHER),
+            EmailCache::DisabledListAddress(OTHER),
+            EmailCache::DisabledAccountAddress(OTHER),
+            EmailCache::DisabledAccountAddress(OWNER),
+        ] {
+            assert!(!catch_all_sender(OWNER, Some(exact), None, Some(OWNER)));
+        }
+    }
+
+    #[test]
+    fn catch_all_sender_denies_sub_address_of_another_account() {
+        assert!(!catch_all_sender(OWNER, None, Some(OTHER), Some(OWNER)));
+    }
+
+    #[test]
+    fn catch_all_sender_denies_catch_all_to_another_account() {
+        assert!(!catch_all_sender(OWNER, None, Some(OTHER), Some(OTHER)));
+    }
+
+    #[test]
+    fn catch_all_sender_denies_without_catch_all() {
+        assert!(!catch_all_sender(OWNER, None, None, None));
+    }
+
+    #[test]
+    fn catch_all_sender_denies_after_revocation() {
+        // Allowed when the identity was created.
+        assert!(catch_all_sender(OWNER, None, Some(OWNER), Some(OWNER)));
+        // Catch-all removed: the address no longer resolves to anyone.
+        assert!(!catch_all_sender(OWNER, None, None, None));
+        // Catch-all repointed to another account.
+        assert!(!catch_all_sender(OWNER, None, Some(OTHER), Some(OTHER)));
+        // Address assigned to another account.
+        let exact = Some(EmailCache::Account(OTHER));
+        assert!(!catch_all_sender(OWNER, exact, Some(OTHER), Some(OWNER)));
+    }
+}
