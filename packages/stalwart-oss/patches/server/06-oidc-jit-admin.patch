+    /// A known external token is not authorization. Before revalidating it at
+    /// the IdP, check its last verified account's budget without incrementing:
+    /// successful authentication below still charges the normal account limit.
+    /// This guard also applies to privileged OIDC sessions to bound IdP work.
+    pub async fn is_http_oidc_revalidation_allowed(
+        &self,
+        account_id: u32,
+        addr: IpAddr,
+    ) -> trc::Result<()> {
+        if let Some(rate) = &self.core.network.http.rate_authenticated
+            && !self.is_ip_allowed(addr)
+            && let Some(reset) = self
+                .core
+                .storage
+                .memory
+                .is_rate_allowed(
+                    KV_RATE_LIMIT_HTTP_AUTHENTICATED,
+                    &account_id.to_be_bytes(),
+                    rate,
+                    true,
+                )
+                .await
+                .caused_by(trc::location!())?
+        {
+            return Err(trc::LimitEvent::TooManyRequests
+                .into_err()
+                .ctx(trc::Key::Expires, reset)
+                .ctx(trc::Key::Limit, rate.count));
+        }
+        Ok(())
+    }
