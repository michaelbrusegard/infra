+impl Account {
+    pub fn has_authorization_group(&self, expected: &str) -> bool {
+        !expected.is_empty()
+            && self
+                .authorization_groups
+                .iter()
+                .any(|group| group.eq_ignore_ascii_case(expected))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::Account;
+
+    #[test]
+    fn independent_scim_oidc_authorization_groups_are_exact_and_case_insensitive() {
+        let account = Account {
+            authorization_groups: vec!["mail-support".into(), "Admin".into()],
+            ..Default::default()
+        };
+        assert!(account.has_authorization_group("admin"));
+        assert!(!account.has_authorization_group("min"));
+        assert!(!account.has_authorization_group(""));
+    }
+}
