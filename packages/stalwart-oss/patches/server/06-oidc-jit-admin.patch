+    pub(crate) fn new_with_superuser_permissions(
+        inner: Arc<AccessTokenInner>,
+        remote_ip: IpAddr,
+    ) -> trc::Result<Self> {
+        // OIDC-backed accounts have no native primary credential, so validity
+        // checking first applies the normal password-change downgrade. Add the
+        // session-only permissions after that check without changing its IP/expiry.
+        let mut token = Self::new(inner, remote_ip)?;
+        if token.has_permission(Permission::Authenticate) {
+            let permissions =
+                Permissions::from_permission(&DefaultPermissions::default().superuser);
+            let scope_idx = token.scope_idx;
+            Arc::make_mut(&mut token.inner).scopes[scope_idx]
+                .permissions
+                .union(&permissions);
+        }
+        Ok(token)
+    }
