<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hermes.agent.accessibility">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="37" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="Hermes Accessibility Companion"
        android:supportsRtl="true">
        <service
            android:name=".HermesAccessibilityService"
            android:description="@string/service_description"
            android:exported="true"
            android:label="Hermes Accessibility Companion"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
        <receiver
            android:name=".ConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.hermes.agent.accessibility.CONFIGURE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
