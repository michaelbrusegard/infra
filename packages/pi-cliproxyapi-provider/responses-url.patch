+	// Allow gateways to expose the standard Responses endpoint.
+	const resolver = "function resolveCodexUrl(baseUrl) {";
+	if (!src.includes(resolver)) {
+		throw new Error("openai-codex-responses source no longer defines resolveCodexUrl");
+	}
+	src = src.replace(
+		resolver,
+		resolver + '\n    if (process.env.CLIPROXYAPI_RESPONSES_URL) return process.env.CLIPROXYAPI_RESPONSES_URL;',
+	);
+
+	// NetBird must inspect the JSON model before forwarding the request.
+	const compression = "const compressedBody = compressRequestBodyZstd(bodyJson);";
+	if (!src.includes(compression)) {
+		throw new Error("openai-codex-responses source no longer defines request compression");
+	}
+	src = src.replace(
+		compression,
+		"const compressedBody = process.env.CLIPROXYAPI_RESPONSES_URL ? null : compressRequestBodyZstd(bodyJson);",
+	);
+
