+func scanMultipartModelStream(body []byte, boundary string) (model string, stream bool, ok bool) {
+	reader := multipart.NewReader(bytes.NewReader(body), boundary)
+	seen := make(map[string]bool)
+	for {
+		part, err := reader.NextPart()
+		if errors.Is(err, io.EOF) {
+			return model, stream, model != ""
+		}
+		if err != nil {
+			return "", false, false
+		}
+		name := part.FormName()
+		if name != "model" && name != "stream" {
+			if err := part.Close(); err != nil {
+				return "", false, false
+			}
+			continue
+		}
+		if seen[name] || part.FileName() != "" {
+			return "", false, false
+		}
+		seen[name] = true
+		value, err := io.ReadAll(io.LimitReader(part, 4097))
+		if err != nil || len(value) > 4096 {
+			return "", false, false
+		}
+		if name == "model" {
+			model = strings.TrimSpace(string(value))
+		} else {
+			stream, err = strconv.ParseBool(strings.TrimSpace(string(value)))
+			if err != nil {
+				return "", false, false
+			}
+		}
+	}
+}
