+func TestRouter_ResponsesWebsocket(t *testing.T) {
+	gateway := ProviderRoute{
+		ID: "gateway", UpstreamScheme: "http", UpstreamHost: "gateway.internal",
+		AuthHeaderName: "Authorization", AuthHeaderValue: "Bearer upstream",
+		AllowedGroupIDs: []string{defaultTestGroup},
+		ModelPolicies:   []ModelPolicyRule{{GroupIDs: []string{defaultTestGroup}}},
+	}
+	handshake := func() *middleware.Input {
+		return &middleware.Input{
+			Slot: middleware.SlotOnRequest, Method: http.MethodGet, URL: "/v1/responses",
+			Headers: []middleware.KV{
+				{Key: "Connection", Value: "keep-alive, Upgrade"},
+				{Key: "Upgrade", Value: "websocket"},
+			},
+			Metadata:   []middleware.KV{{Key: middleware.KeyLLMProvider, Value: "openai"}},
+			UserGroups: []string{defaultTestGroup},
+		}
+	}
+
+	for name, tc := range map[string]struct {
+		route  func(ProviderRoute) ProviderRoute
+		input  func(*middleware.Input)
+		reason string
+	}{
+		"allow": {},
+		"group-denied": {
+			input:  func(in *middleware.Input) { in.UserGroups = []string{"other"} },
+			reason: denyReasonNoAuthorisedRoute,
+		},
+		"enumerated-models": {
+			route:  func(r ProviderRoute) ProviderRoute { r.Models = []string{"gpt-test"}; return r },
+			reason: denyReasonNotRoutable,
+		},
+		"policy-allowlist": {
+			route: func(r ProviderRoute) ProviderRoute {
+				r.ModelPolicies = []ModelPolicyRule{{GroupIDs: []string{defaultTestGroup}, Models: []string{"gpt-test"}}}
+				return r
+			},
+			reason: denyReasonNotRoutable,
+		},
+		"no-upgrade": {
+			input:  func(in *middleware.Input) { in.Headers = nil },
+			reason: denyReasonNotRoutable,
+		},
+		"post": {
+			input:  func(in *middleware.Input) { in.Method = http.MethodPost },
+			reason: denyReasonNotRoutable,
+		},
+		"other-path": {
+			input:  func(in *middleware.Input) { in.URL = "/v1/chat/completions" },
+			reason: denyReasonNotRoutable,
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			route := gateway
+			if tc.route != nil {
+				route = tc.route(route)
+			}
+			in := handshake()
+			if tc.input != nil {
+				tc.input(in)
+			}
+			out, err := New(Config{Providers: []ProviderRoute{route}}).Invoke(context.Background(), in)
+			require.NoError(t, err)
+			if tc.reason != "" {
+				require.Equal(t, middleware.DecisionDeny, out.Decision)
+				reason, _ := metaValue(t, out.Metadata, middleware.KeyLLMPolicyReason)
+				require.Equal(t, tc.reason, reason)
+				return
+			}
+			require.Equal(t, middleware.DecisionAllow, out.Decision)
+			rewrite := out.Mutations.RewriteUpstream
+			require.Equal(t, "gateway.internal", rewrite.Host)
+			require.Equal(t, "Bearer upstream", rewrite.AuthHeader.Value)
+			require.Contains(t, rewrite.StripHeaders, "Authorization")
+			_, nonInference := metaValue(t, out.Metadata, middleware.KeyLLMNonInference)
+			require.False(t, nonInference, "the limit check must still run for a socket")
+		})
+	}
+}
