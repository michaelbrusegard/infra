diff --git a/proxy/internal/proxy/websocket_test.go b/proxy/internal/proxy/websocket_test.go
new file mode 100644
index 0000000..e865537
--- /dev/null
+++ b/proxy/internal/proxy/websocket_test.go
@@ -0,0 +1,116 @@
+package proxy
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	log "github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+
+	"github.com/netbirdio/netbird/proxy/internal/middleware"
+	"github.com/netbirdio/netbird/proxy/internal/middleware/bodytap"
+	"github.com/netbirdio/netbird/proxy/internal/middleware/builtin/llm_guardrail"
+	"github.com/netbirdio/netbird/proxy/internal/middleware/builtin/llm_request_parser"
+	"github.com/netbirdio/netbird/proxy/internal/middleware/builtin/llm_router"
+)
+
+// A Responses WebSocket handshake routes through the production chain, gets
+// the upstream credential, and the upgraded stream carries bytes both ways.
+func TestResponsesWebsocketForwarding(t *testing.T) {
+	for _, access := range []string{"allow", "group-denied"} {
+		t.Run(access, func(t *testing.T) {
+			hits := 0
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				hits++
+				require.Equal(t, "/v1/responses", r.URL.Path)
+				require.Equal(t, "Bearer test-upstream-key", r.Header.Get("Authorization"))
+				require.Equal(t, "websocket", r.Header.Get("Upgrade"))
+				conn, buf, err := http.NewResponseController(w).Hijack()
+				require.NoError(t, err)
+				defer conn.Close()
+				_, err = buf.WriteString("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
+				require.NoError(t, err)
+				require.NoError(t, buf.Flush())
+				frame := make([]byte, 4)
+				_, err = io.ReadFull(buf, frame)
+				require.NoError(t, err)
+				_, err = conn.Write(frame)
+				require.NoError(t, err)
+			}))
+			defer upstream.Close()
+			u, err := url.Parse(upstream.URL)
+			require.NoError(t, err)
+
+			registry := middleware.NewRegistry()
+			registry.MustRegister(llm_request_parser.Factory{})
+			registry.MustRegister(llm_router.Factory{})
+			registry.MustRegister(llm_guardrail.Factory{})
+			routerConfig, err := json.Marshal(llm_router.Config{Providers: []llm_router.ProviderRoute{{
+				ID: "cliproxy", UpstreamScheme: u.Scheme, UpstreamHost: u.Host,
+				AllowedGroupIDs: []string{"AI"}, AuthHeaderName: "Authorization", AuthHeaderValue: "Bearer test-upstream-key",
+			}}})
+			require.NoError(t, err)
+			specs := []middleware.Spec{
+				{ID: llm_request_parser.ID, Enabled: true, Slot: middleware.SlotOnRequest, RawConfig: []byte(`{"capture_prompt":false}`)},
+				{ID: llm_router.ID, Enabled: true, Slot: middleware.SlotOnRequest, CanMutate: true, RawConfig: routerConfig},
+				{ID: llm_guardrail.ID, Enabled: true, Slot: middleware.SlotOnRequest, RawConfig: []byte(`{}`)},
+			}
+			logger := log.New()
+			logger.SetLevel(log.ErrorLevel)
+			const captureBytes = 1 << 20
+			manager := middleware.NewManager(captureBytes, nil, logger)
+			manager.SetResolver(middleware.NewResolver(registry))
+			require.NoError(t, manager.Rebuild("ws", []middleware.PathTargetBinding{{ServiceID: "ws", PathID: "/", Specs: specs}}))
+			chain := manager.ChainFor("ws", "/")
+			defer chain.Close(context.Background())
+			proxy := &ReverseProxy{middlewareManager: manager, logger: logger, transport: http.DefaultTransport, forwardedProto: "auto"}
+			result := targetResult{serviceID: "ws", matchedPath: "/", target: &PathTarget{
+				URL: u, AgentNetwork: true, Middlewares: specs,
+				CaptureConfig: &bodytap.Config{MaxRequestBytes: captureBytes, MaxResponseBytes: captureBytes, ContentTypes: []string{"application/json"}},
+			}}
+			groups := []string{"AI"}
+			if access == "group-denied" {
+				groups = []string{"other"}
+			}
+			gateway := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				caller := &CapturedData{}
+				caller.SetUserGroups(groups)
+				proxy.serveWithChain(w, r, r.Context(), result, chain, "", caller)
+			}))
+			defer gateway.Close()
+
+			conn, err := net.Dial("tcp", gateway.Listener.Addr().String())
+			require.NoError(t, err)
+			defer conn.Close()
+			_, err = io.WriteString(conn, "GET /v1/responses HTTP/1.1\r\nHost: ai.test\r\n"+
+				"Authorization: Bearer client-placeholder\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n"+
+				"Sec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"+
+				"OpenAI-Beta: responses_websockets=2026-02-06\r\n\r\n")
+			require.NoError(t, err)
+			reader := bufio.NewReader(conn)
+			response, err := http.ReadResponse(reader, nil)
+			require.NoError(t, err)
+			if access != "allow" {
+				require.Equal(t, http.StatusForbidden, response.StatusCode)
+				require.Zero(t, hits)
+				return
+			}
+			require.Equal(t, http.StatusSwitchingProtocols, response.StatusCode)
+			require.True(t, manager.Budget().Acquire(captureBytes), "an open socket must not hold capture budget")
+			manager.Budget().Release(captureBytes)
+			_, err = io.WriteString(conn, "ping")
+			require.NoError(t, err)
+			echo := make([]byte, 4)
+			_, err = io.ReadFull(reader, echo)
+			require.NoError(t, err)
+			require.Equal(t, "ping", string(echo))
+		})
+	}
+}
