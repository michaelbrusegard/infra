+// responsesWebsocketPath is the OpenAI Responses endpoint Codex upgrades to a
+// WebSocket when the provider sets supports_websockets.
+const responsesWebsocketPath = "/v1/responses"
+
+// isResponsesWebsocketHandshake reports whether the request is a WebSocket
+// upgrade to the OpenAI Responses endpoint. The handshake is a bodiless GET;
+// every model arrives later in a response.create frame the proxy never reads.
+func isResponsesWebsocketHandshake(reqPath, surface string, in *middleware.Input) bool {
+	if in.Method != http.MethodGet || reqPath != responsesWebsocketPath || surface != "openai" {
+		return false
+	}
+	var upgrade, connection bool
+	for _, kv := range in.Headers {
+		switch {
+		case strings.EqualFold(kv.Key, "Upgrade"):
+			upgrade = upgrade || strings.EqualFold(strings.TrimSpace(kv.Value), "websocket")
+		case strings.EqualFold(kv.Key, "Connection"):
+			for _, token := range strings.Split(kv.Value, ",") {
+				connection = connection || strings.EqualFold(strings.TrimSpace(token), "upgrade")
+			}
+		}
+	}
+	return upgrade && connection
+}
+
+// routeResponsesWebsocket authorises a Responses WebSocket handshake. The
+// proxy cannot check the model of any later frame, so a socket is admitted
+// only where no model check could deny it: a route that claims every model,
+// for a caller none of whose policies sets a model allowlist. Group
+// authorisation and upstream credential injection are unchanged. The socket
+// is deliberately not marked non-inference, so the limit check still runs.
+func (m *Middleware) routeResponsesWebsocket(reqPath, surface string, userGroups []string) *middleware.Output {
+	route, outcome := m.matchRoute("", surface, reqPath, userGroups)
+	switch outcome {
+	case matchOutcomeFound:
+	case matchOutcomeUnauthorised:
+		return denyNoAuthorisedRoute(surface, "")
+	default:
+		return denyMissingModel(surface)
+	}
+	if len(route.Models) > 0 || route.Vertex || route.Bedrock {
+		return denyMissingModel(surface)
+	}
+	if _, restricted := policyPermittedModels(route, userGroups); restricted {
+		return denyMissingModel(surface)
+	}
+	return m.allowWithRoute(route, surface, userGroups)
+}
