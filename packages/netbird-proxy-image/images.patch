+package bodytap
+
+import (
+	"bytes"
+	"io"
+	"mime/multipart"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestImagesMultipartRoutingRestoresBody(t *testing.T) {
+	for _, fileFirst := range []bool{false, true} {
+		var body bytes.Buffer
+		writer := multipart.NewWriter(&body)
+		writeFile := func() {
+			p, err := writer.CreateFormFile("image[]", "reference.png")
+			require.NoError(t, err)
+			_, err = p.Write(bytes.Repeat([]byte{0, 255, 1, 2}, 300000))
+			require.NoError(t, err)
+		}
+		if fileFirst {
+			writeFile()
+		}
+		require.NoError(t, writer.WriteField("model", "gpt-image-2.5-sunburst"))
+		require.NoError(t, writer.WriteField("stream", "true"))
+		if !fileFirst {
+			writeFile()
+		}
+		require.NoError(t, writer.Close())
+		request := httptest.NewRequest("POST", "/v1/images/edits", bytes.NewReader(body.Bytes()))
+		request.Header.Set("Content-Type", writer.FormDataContentType())
+		model, stream, ok := ScanRoutingFields(request, MaxRoutingScanBytes)
+		require.True(t, ok)
+		require.Equal(t, "gpt-image-2.5-sunburst", model)
+		require.True(t, stream)
+		forwarded, err := io.ReadAll(request.Body)
+		require.NoError(t, err)
+		require.Equal(t, body.Bytes(), forwarded)
+	}
+}
+
+func TestImagesMultipartRejectsAmbiguousOrTruncatedModel(t *testing.T) {
+	for _, duplicate := range []bool{false, true} {
+		var body bytes.Buffer
+		writer := multipart.NewWriter(&body)
+		require.NoError(t, writer.WriteField("model", "gpt-image-2.5-sunburst"))
+		if duplicate {
+			require.NoError(t, writer.WriteField("model", "different-model"))
+		}
+		require.NoError(t, writer.Close())
+		request := httptest.NewRequest("POST", "/v1/images/edits", bytes.NewReader(body.Bytes()))
+		request.Header.Set("Content-Type", writer.FormDataContentType())
+		limit := MaxRoutingScanBytes
+		if !duplicate {
+			limit = int64(body.Len() - 10)
+		}
+		_, _, ok := ScanRoutingFields(request, limit)
+		require.False(t, ok)
+		forwarded, err := io.ReadAll(request.Body)
+		require.NoError(t, err)
+		require.Equal(t, body.Bytes(), forwarded)
+	}
+}
