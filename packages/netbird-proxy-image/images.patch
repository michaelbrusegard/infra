@@ -0,0 +1,57 @@
+package llm_request_parser
+
+import (
+	"context"
+	"testing"
+
+	"github.com/netbirdio/netbird/proxy/internal/middleware"
+	"github.com/netbirdio/netbird/proxy/internal/middleware/builtin/llm_guardrail"
+	"github.com/netbirdio/netbird/proxy/internal/middleware/builtin/llm_router"
+	"github.com/stretchr/testify/require"
+)
+
+func TestImagesRoutingAndPolicy(t *testing.T) {
+	for _, path := range []string{"/v1/images/generations", "/v1/images/edits"} {
+		t.Run(path, func(t *testing.T) {
+			parser, err := Factory{}.New([]byte(`{"capture_prompt":false}`))
+			require.NoError(t, err)
+			in := &middleware.Input{URL: path, Method: "POST", UserGroups: []string{"AI"},
+				Body: []byte(`{"model":"gpt-image-2.5-sunburst","prompt":"private prompt","images":[{"image_url":"data:image/png;base64,AAAA"}]}`)}
+			parsed, err := parser.Invoke(context.Background(), in)
+			require.NoError(t, err)
+			model, found := metaValue(t, parsed.Metadata, middleware.KeyLLMModel)
+			require.True(t, found, "image requests must expose a model to the router")
+			require.Equal(t, "gpt-image-2.5-sunburst", model)
+			_, promptCaptured := metaValue(t, parsed.Metadata, middleware.KeyLLMRequestPromptRaw)
+			require.False(t, promptCaptured)
+			in.Metadata = parsed.Metadata
+			router := llm_router.New(llm_router.Config{Providers: []llm_router.ProviderRoute{{
+				ID: "cliproxy", UpstreamScheme: "http", UpstreamHost: "upstream.test:8317",
+				AuthHeaderName: "Authorization", AuthHeaderValue: "Bearer upstream-test",
+				AllowedGroupIDs: []string{"AI"},
+			}}})
+			routed, err := router.Invoke(context.Background(), in)
+			require.NoError(t, err)
+			require.Equal(t, middleware.DecisionAllow, routed.Decision)
+			in.Metadata = append(in.Metadata, routed.Metadata...)
+			for _, allowed := range []bool{false, true} {
+				models := []string{"gpt-6.1-sol", "kimi-k3.1-pro"}
+				if allowed {
+					models = append(models, "gpt-image-2.5-sunburst")
+				}
+				guard := llm_guardrail.New(llm_guardrail.Config{ProviderAllowlists: map[string][]string{"cliproxy": models}})
+				out, err := guard.Invoke(context.Background(), in)
+				require.NoError(t, err)
+				if allowed {
+					require.Equal(t, middleware.DecisionAllow, out.Decision)
+				} else {
+					require.Equal(t, middleware.DecisionDeny, out.Decision)
+				}
+			}
+			in.UserGroups = []string{"unrelated"}
+			denied, err := router.Invoke(context.Background(), in)
+			require.NoError(t, err)
+			require.Equal(t, middleware.DecisionDeny, denied.Decision)
+		})
+	}
+}
