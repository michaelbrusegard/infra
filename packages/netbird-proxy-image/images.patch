@@ -0,0 +1,135 @@
+package proxy
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/netbirdio/netbird/proxy/internal/middleware"
+	"github.com/netbirdio/netbird/proxy/internal/middleware/bodytap"
+	"github.com/netbirdio/netbird/proxy/internal/middleware/builtin/llm_guardrail"
+	"github.com/netbirdio/netbird/proxy/internal/middleware/builtin/llm_request_parser"
+	"github.com/netbirdio/netbird/proxy/internal/middleware/builtin/llm_router"
+	log "github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+// Exercise the production capture -> policy chain -> HTTP forwarding path.
+// Authentication has already supplied the caller's groups at this boundary.
+func TestImagesHTTPForwarding(t *testing.T) {
+	for _, form := range []string{"generate-json", "edit-json", "edit-multipart", "claude", "responses", "speech", "tts", "videos", "video-edit", "video-extension", "openai-video", "search", "codex-search", "codex-responses", "compact", "interactions"} {
+		for _, access := range []string{"allow", "model-denied", "group-denied"} {
+			t.Run(form+"/"+access, func(t *testing.T) {
+				model := "gpt-image-2.5-sunburst"
+				path := "/v1/images/generations"
+				contentType := "application/json"
+				body := []byte(`{"model":"` + model + `","prompt":"test"}`)
+				if form == "edit-json" {
+					path = "/v1/images/edits"
+					body = []byte(`{"model":"` + model + `","images":[{"image_url":"data:image/png;base64,` + strings.Repeat("A", 2<<20) + `"}],"prompt":"test"}`)
+				} else if form == "edit-multipart" {
+					path = "/v1/images/edits"
+					var buf bytes.Buffer
+					writer := multipart.NewWriter(&buf)
+					part, err := writer.CreateFormFile("image[]", "target.png")
+					require.NoError(t, err)
+					_, err = part.Write(bytes.Repeat([]byte{0, 1, 255}, 400000))
+					require.NoError(t, err)
+					require.NoError(t, writer.WriteField("model", model))
+					require.NoError(t, writer.WriteField("prompt", "test"))
+					require.NoError(t, writer.Close())
+					body, contentType = buf.Bytes(), writer.FormDataContentType()
+				} else if form == "claude" || form == "responses" {
+					path = "/v1/messages"
+					if form == "responses" {
+						path = "/v1/responses"
+					}
+					model = "existing-text-model"
+					body = []byte(`{"model":"` + model + `","messages":[],"input":[]}`)
+				}
+				paths := map[string]string{
+					"speech": "/v1/audio/speech", "tts": "/v1/tts",
+					"videos": "/v1/videos/generations", "video-edit": "/v1/videos/edits",
+					"video-extension": "/v1/videos/extensions", "openai-video": "/openai/v1/videos",
+					"search": "/v1/alpha/search", "codex-search": "/backend-api/codex/alpha/search",
+					"codex-responses": "/backend-api/codex/responses", "compact": "/v1/responses/compact",
+					"interactions": "/v1beta/interactions",
+				}
+				if endpoint, ok := paths[form]; ok {
+					path = endpoint
+				}
+				hits := 0
+				upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					hits++
+					got, err := io.ReadAll(r.Body)
+					require.NoError(t, err)
+					require.Equal(t, body, got, "the uploaded files must remain byte-for-byte intact")
+					require.Equal(t, path, r.URL.Path)
+					require.Equal(t, contentType, r.Header.Get("Content-Type"))
+					require.Equal(t, "Bearer test-upstream-key", r.Header.Get("Authorization"))
+					w.WriteHeader(http.StatusOK)
+				}))
+				defer upstream.Close()
+				u, err := url.Parse(upstream.URL)
+				require.NoError(t, err)
+				registry := middleware.NewRegistry()
+				registry.MustRegister(llm_request_parser.Factory{})
+				registry.MustRegister(llm_router.Factory{})
+				registry.MustRegister(llm_guardrail.Factory{})
+				routerConfig, err := json.Marshal(llm_router.Config{Providers: []llm_router.ProviderRoute{{
+					ID: "cliproxy", UpstreamScheme: u.Scheme, UpstreamHost: u.Host,
+					AllowedGroupIDs: []string{"AI"}, AuthHeaderName: "Authorization", AuthHeaderValue: "Bearer test-upstream-key",
+				}}})
+				require.NoError(t, err)
+				allowedModel := model
+				if access == "model-denied" {
+					allowedModel = "different-model"
+				}
+				guardConfig, err := json.Marshal(llm_guardrail.Config{ProviderAllowlists: map[string][]string{"cliproxy": {allowedModel}}})
+				require.NoError(t, err)
+				specs := []middleware.Spec{
+					{ID: llm_request_parser.ID, Enabled: true, Slot: middleware.SlotOnRequest, RawConfig: []byte(`{"capture_prompt":false}`)},
+					{ID: llm_router.ID, Enabled: true, Slot: middleware.SlotOnRequest, CanMutate: true, RawConfig: routerConfig},
+					{ID: llm_guardrail.ID, Enabled: true, Slot: middleware.SlotOnRequest, RawConfig: guardConfig},
+				}
+				logger := log.New()
+				logger.SetLevel(log.ErrorLevel)
+				manager := middleware.NewManager(0, nil, logger)
+				manager.SetResolver(middleware.NewResolver(registry))
+				require.NoError(t, manager.Rebuild("images", []middleware.PathTargetBinding{{ServiceID: "images", PathID: "/", Specs: specs}}))
+				chain := manager.ChainFor("images", "/")
+				defer chain.Close(context.Background())
+				proxy := &ReverseProxy{middlewareManager: manager, logger: logger, transport: http.DefaultTransport, forwardedProto: "auto"}
+				result := targetResult{serviceID: "images", matchedPath: "/", target: &PathTarget{
+					URL: u, AgentNetwork: true, Middlewares: specs,
+					CaptureConfig: &bodytap.Config{MaxRequestBytes: 1 << 20, ContentTypes: []string{"application/json"}},
+				}}
+				request := httptest.NewRequest("POST", "http://gateway.test"+path, bytes.NewReader(body))
+				request.Header.Set("Content-Type", contentType)
+				request.Header.Set("Authorization", "Bearer client-placeholder")
+				caller := &CapturedData{}
+				groups := []string{"AI"}
+				if access == "group-denied" {
+					groups = []string{"other"}
+				}
+				caller.SetUserGroups(groups)
+				response := httptest.NewRecorder()
+				proxy.serveWithChain(response, request, context.Background(), result, chain, "", caller)
+				if access == "allow" {
+					require.Equal(t, 200, response.Code, response.Body.String())
+					require.Equal(t, 1, hits)
+				} else {
+					require.Equal(t, 403, response.Code, response.Body.String())
+					require.Zero(t, hits)
+				}
+			})
+		}
+	}
+}
