+// YV12 as system/graphics.h defines it: a Y plane, then Cr, then Cb, with
+// chroma rows at half the luma stride rounded up to 16 bytes.
+inline size_t yv12_chroma_stride(size_t stride) {
+    return (stride / 2 + 15) & ~size_t(15);
+}
+inline size_t yv12_chroma_size(size_t stride, size_t height) {
+    return yv12_chroma_stride(stride) * (height / 2);
+}
+inline size_t yv12_size(size_t stride, size_t height) {
+    return stride * height + 2 * yv12_chroma_size(stride, height);
+}
