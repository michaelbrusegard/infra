+int gralloc_lock_ycbcr(gralloc_module_t const* /*module*/,
+        buffer_handle_t handle, int /*usage*/,
+        int l, int t, int /*w*/, int /*h*/,
+        struct android_ycbcr* ycbcr)
+{
+    // Software readers and the Vulkan and GL drivers both lock YUV buffers
+    // through here; without it, sampling a YV12 video frame fails.
+    if (private_handle_t::validate(handle) < 0)
+        return -EINVAL;
+
+    private_handle_t* hnd = (private_handle_t*)handle;
+    if (hnd->format != HAL_PIXEL_FORMAT_YV12)
+        return -EINVAL;
+
+    uint8_t* base = (uint8_t*)hnd->base;
+    size_t stride = hnd->stride;
+    size_t chromaStride = yv12_chroma_stride(stride);
+    uint8_t* cr = base + stride * hnd->height;
+    uint8_t* cb = cr + yv12_chroma_size(stride, hnd->height);
+    size_t chromaOffset = (t / 2) * chromaStride + l / 2;
+
+    memset(ycbcr, 0, sizeof(*ycbcr));
+    ycbcr->y = base + t * stride + l;
+    ycbcr->cr = cr + chromaOffset;
+    ycbcr->cb = cb + chromaOffset;
+    ycbcr->ystride = stride;
+    ycbcr->cstride = chromaStride;
+    ycbcr->chroma_step = 1;
+    return 0;
+}
