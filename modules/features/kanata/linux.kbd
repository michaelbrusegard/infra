(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  delegate-to-first-layer yes
)

(defsrc
  caps a s d f j k l ;
  102d
  lsft lctl lmet lalt ralt rmet rctl f23
  bspc del
)

(defvar
  tapping_term 200
)

(defalias
  a (tap-hold-release $tapping_term $tapping_term a lmet)
  s (tap-hold-release $tapping_term $tapping_term s lalt)
  d (tap-hold-release $tapping_term $tapping_term d lsft)
  f (tap-hold-release $tapping_term $tapping_term f lctl)
  j (tap-hold-release $tapping_term $tapping_term j rctl)
  k (tap-hold-release $tapping_term $tapping_term k rsft)
  l (tap-hold-release $tapping_term $tapping_term l lalt)
  ; (tap-hold-release $tapping_term $tapping_term ; rmet)
  ;; The Copilot key emits lsft+lmet+f23 as one chord. Map it to Alt; the
  ;; fork re-adds Shift so a manually held Shift survives (Shift+Alt).
  cplt (fork lalt (multi lsft lalt) (lsft))
  ;; Cmd+Backspace and Cmd+Delete clear to the start and end of the line, as
  ;; on macOS. No single Linux shortcut does that, so select and delete.
  bspc (fork bspc (macro (unmod (lctl rctl) lsft home) (unmod (lctl rctl) bspc)) (lctl rctl))
  del (fork del (macro (unmod (lctl rctl) lsft end) (unmod (lctl rctl) del)) (lctl rctl))
)

(defchordsv2
  (lsft lmet f23) @cplt 5 first-release ()
)

(deflayer base
  esc @a @s @d @f @j @k @l @;
  lsft
  lsft lmet lalt lctl rctl lalt rmet lalt
  @bspc @del
)

;; Hyprland switches to this layer while Ghostty is focused. The shell does its
;; own line editing there, so the Mac text shortcuts below stay off.
(deflayer terminal
  _ _ _ _ _ _ _ _ _
  _
  _ _ _ _ _ _ _ _
  bspc del
)

(deflayer nomods
  esc a s d f j k l ;
  lsft
  lsft lctl lmet lalt ralt rmet rctl ralt
  bspc del
)

;; Every Option key sends a real Alt, and Option+key types the us(mac) symbol
;; through AltGr as on a Mac. It stays Alt with Ctrl or Super held, so app
;; shortcuts work, and on the keys the window manager binds: hjkl and digits,
;; which AeroSpace also takes on macOS.
(deftemplate option-symbol (key)
  (lalt $key) (ralt $key) (lctl rctl lmet rmet) ()
)

;; Cmd+arrows jump to the line or document edge and Option+arrows jump by word
;; or paragraph, as on macOS, by sending the Linux shortcut for each.
(deftemplate cmd-text (key out)
  (lctl $key) $out (lalt lmet rmet) (terminal nomods)
  (rctl $key) $out (lalt lmet rmet) (terminal nomods)
)

(deftemplate option-text (key)
  (lalt $key) (lctl $key) (lctl rctl lmet rmet) (terminal nomods)
)

(defoverridesv2
  (t! option-symbol a)
  (t! option-symbol b)
  (t! option-symbol c)
  (t! option-symbol d)
  (t! option-symbol e)
  (t! option-symbol f)
  (t! option-symbol g)
  (t! option-symbol i)
  (t! option-symbol m)
  (t! option-symbol n)
  (t! option-symbol o)
  (t! option-symbol p)
  (t! option-symbol q)
  (t! option-symbol r)
  (t! option-symbol s)
  (t! option-symbol t)
  (t! option-symbol u)
  (t! option-symbol v)
  (t! option-symbol w)
  (t! option-symbol x)
  (t! option-symbol y)
  (t! option-symbol z)
  (t! option-symbol grv)
  (t! option-symbol min)
  (t! option-symbol eql)
  (t! option-symbol [)
  (t! option-symbol ])
  (t! option-symbol \)
  (t! option-symbol ;)
  (t! option-symbol ')
  (t! option-symbol ,)
  (t! option-symbol .)
  (t! option-symbol /)

  (t! cmd-text left (home))
  (t! cmd-text right (end))
  (t! cmd-text up (lctl home))
  (t! cmd-text down (lctl end))

  (t! option-text left)
  (t! option-text right)
  (t! option-text up)
  (t! option-text down)
  (t! option-text bspc)
  (t! option-text del)
)
