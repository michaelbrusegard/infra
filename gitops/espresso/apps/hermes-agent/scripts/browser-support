#!/bin/sh
set -eu

agent_python=$(command -v python3 || true)
if [ -z "$agent_python" ]; then
  agent_python=$(
    sed -n "s/^export HERMES_PYTHON='\(.*\)'$/\1/p" "$(command -v hermes)"
  )
fi
if [ -z "$agent_python" ] || [ ! -x "$agent_python" ]; then
  echo "browser-support: unable to locate a Python environment" >&2
  exit 1
fi

exec "$agent_python" /opt/data/scripts/browser-support.py "$@"
