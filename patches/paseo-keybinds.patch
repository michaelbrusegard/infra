diff --git a/packages/app/src/terminal/runtime/terminal-emulator-runtime.ts b/packages/app/src/terminal/runtime/terminal-emulator-runtime.ts
index 56350ef9..66069353 100644
--- a/packages/app/src/terminal/runtime/terminal-emulator-runtime.ts
+++ b/packages/app/src/terminal/runtime/terminal-emulator-runtime.ts
@@ -130,0 +131,29 @@ const isMac =
+const metaToCtrlKeys = new Set([
+  ..."abcdefghijklmnopqrstuvwxyz0123456789",
+  " ",
+  "[",
+  "]",
+  "\\",
+  "-",
+  "/",
+  "_",
+  "^",
+  "ArrowLeft",
+  "ArrowRight",
+  "ArrowUp",
+  "ArrowDown",
+  "Backspace",
+  "Delete",
+  "Enter",
+]);
+
+function shouldTranslateMetaToCtrl(event: KeyboardEvent, key: string): boolean {
+  if (isMac || !event.metaKey || event.ctrlKey || event.altKey) {
+    return false;
+  }
+  if (event.shiftKey) {
+    return key === "_" || key === "^";
+  }
+  return metaToCtrlKeys.has(key);
+}
+
@@ -449,0 +479,13 @@ export class TerminalEmulatorRuntime {
+      if (shouldTranslateMetaToCtrl(event, normalizedKey)) {
+        this.callbacks.onTerminalKey?.({
+          key: normalizeTerminalTransportKey(normalizedKey),
+          ctrl: true,
+          shift: false,
+          alt: false,
+          meta: false,
+        });
+        event.preventDefault();
+        event.stopPropagation();
+        return false;
+      }
+
