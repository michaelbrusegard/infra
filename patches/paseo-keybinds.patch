+const metaToCtrlKeys = new Set([
+  ..."abcdefghijklmnopqrstuvwxyz0123456789",
+  " ",
+  "[",
+  "]",
+  "\\",
+  "-",
+  "/",
+  "_",
+  "^",
+  "ArrowLeft",
+  "ArrowRight",
+  "ArrowUp",
+  "ArrowDown",
+  "Backspace",
+  "Delete",
+  "Enter",
+]);
+
+function shouldTranslateMetaToCtrl(event: KeyboardEvent, key: string, isMac: boolean): boolean {
+  if (isMac || !event.metaKey || event.ctrlKey || event.altKey) {
+    return false;
+  }
+  if (event.shiftKey) {
+    return key === "_" || key === "^";
+  }
+  return metaToCtrlKeys.has(key);
+}
