(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  caps a s d f j k l ;
  102d
  lsft lctl lmet lalt ralt rmet rctl f23
)

(defvar
  tapping_term 200
)

(defalias
  a (tap-hold-release $tapping_term $tapping_term a lmet)
  s (tap-hold-release $tapping_term $tapping_term s lalt)
  d (tap-hold-release $tapping_term $tapping_term d lsft)
  f (tap-hold-release $tapping_term $tapping_term f lctl)
  j (tap-hold-release $tapping_term $tapping_term j rctl)
  k (tap-hold-release $tapping_term $tapping_term k rsft)
  l (tap-hold-release $tapping_term $tapping_term l ralt)
  ; (tap-hold-release $tapping_term $tapping_term ; rmet)
  ;; The Copilot key emits lsft+lmet+f23 as one chord. Map it to AltGr; the
  ;; fork re-adds Shift so a manually held Shift survives (Shift+AltGr).
  cplt (fork ralt (multi lsft ralt) (lsft))
)

(defchordsv2
  (lsft lmet f23) @cplt 5 first-release ()
)

(deflayer base
  esc @a @s @d @f @j @k @l @;
  lsft
  lsft lmet lalt lctl rctl ralt rmet ralt
)

(deflayer nomods
  esc a s d f j k l ;
  lsft
  lsft lctl lmet lalt ralt rmet rctl ralt
)
